# Copiez ce fichier en ".env" puis exportez les variables (voir README) ou définissez-les dans votre terminal.
DJANGO_SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL (optionnel : sans ces variables, l'API utilise SQLite)
# POSTGRES_DB=taskify
# POSTGRES_USER=taskify
# POSTGRES_PASSWORD=taskify
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Pointage : mettre 0 pour désactiver la vérification de zone (démonstrations)
TASKIFY_ENFORCE_ZONE=1
# Lieu de travail par défaut
# TASKIFY_SITE_LAT=4.0511
# TASKIFY_SITE_LNG=9.7679
# TASKIFY_SITE_RADIUS=200
